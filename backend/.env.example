# ParcelFlow Backend Configuration

# Environment
ENVIRONMENT=development
DEBUG=true

# Secret Key (generate a new one for production!)
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# Database
DATABASE_URL=sqlite:///./parcelflow.db

# For production PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/parcelflow

# CORS Origins (comma-separated for production)
# CORS_ORIGINS=http://localhost:5000,https://yourdomain.com

# Frontend URL
FRONTEND_URL=http://localhost:5000

# Email Configuration (optional for development)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM_NAME=ParcelFlow
# EMAIL_FROM_ADDRESS=noreply@parcelflow.com
